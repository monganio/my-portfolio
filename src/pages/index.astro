				Start
			</button>
			<div class="taskbar-windows" id="taskbar-windows"></div>
			<div class="system-tray">
				<img src="/my-portfolio/icons/Category/Volume/Volume.ico" width="16" title="Volume" />
				<img src="/my-portfolio/icons/Category/Network/Network.ico" width="16" title="Network" />
				<img src="/my-portfolio/icons/Category/Programs/AVZ.ico" width="16" title="Antivirus" />
			</div>
			<div class="time" id="clock">12:00 PM</div>
		</div>

		<script is:inline>
			const windowStates = {};
			
			function openWindow(id) {
				const win = document.getElementById(id);
				win.style.display = 'block';
				win.style.zIndex = Number(new Date().getTime() / 1000).toFixed(0);
				if (windowStates[id]?.minimized) {
					windowStates[id].minimized = false;
				}
				updateTaskbar();
			}
			
			function openWindowMobile(e, id) {
				e.preventDefault();
				openWindow(id);
			}
			
			function closeWindow(id) {
				document.getElementById(id).style.display = 'none';
				updateTaskbar();
			}
			
			function minimizeWindow(id) {
				const win = document.getElementById(id);
				win.style.display = 'none';
				windowStates[id] = { minimized: true };
				updateTaskbar();
			}
			
			function maximizeWindow(id) {
				const win = document.getElementById(id);
				if (!windowStates[id]) windowStates[id] = {};
				
				if (windowStates[id].maximized) {
					win.style.width = windowStates[id].oldWidth;
					win.style.height = windowStates[id].oldHeight;
					win.style.left = windowStates[id].oldLeft;
					win.style.top = windowStates[id].oldTop;
					windowStates[id].maximized = false;
				} else {
					windowStates[id].oldWidth = win.style.width || '600px';
					windowStates[id].oldHeight = win.style.height || 'auto';
					windowStates[id].oldLeft = win.style.left || '150px';
					windowStates[id].oldTop = win.style.top || '50px';
					
					win.style.width = 'calc(100vw - 10px)';
					win.style.height = 'calc(100vh - 45px)';
					win.style.left = '5px';
					win.style.top = '5px';
					windowStates[id].maximized = true;
				}
			}
			
			function updateTaskbar() {
				const taskbarWindows = document.getElementById('taskbar-windows');
				taskbarWindows.innerHTML = '';
				
				const windows = document.querySelectorAll('.draggable-window');
				windows.forEach(win => {
					if (win.style.display === 'block' || windowStates[win.id]?.minimized) {
						const title = win.querySelector('.title-bar-text').textContent;
						const btn = document.createElement('button');
						btn.className = 'taskbar-item';
						btn.textContent = title.length > 20 ? title.substring(0, 20) + '...' : title;
						btn.onclick = () => {
							if (windowStates[win.id]?.minimized) {
								openWindow(win.id);
							} else {
								minimizeWindow(win.id);
							}
						};
						taskbarWindows.appendChild(btn);
					}
				});
			}

			// Draggable Script
			const windows = document.querySelectorAll('.draggable-window');
			windows.forEach(win => {
				const titleBar = win.querySelector('.title-bar');
				let isDragging = false;
				let offset = { x: 0, y: 0 };

				// Mouse events
				titleBar.addEventListener('mousedown', (e) => {
					isDragging = true;
					offset.x = e.clientX - win.offsetLeft;
					offset.y = e.clientY - win.offsetTop;
					win.style.zIndex = Number(new Date().getTime() / 1000).toFixed(0);
				});

				document.addEventListener('mousemove', (e) => {
					if (!isDragging) return;
					win.style.left = (e.clientX - offset.x) + 'px';
					win.style.top = (e.clientY - offset.y) + 'px';
				});

				document.addEventListener('mouseup', () => isDragging = false);
				
				// Touch events for mobile
				titleBar.addEventListener('touchstart', (e) => {
					isDragging = true;
					const touch = e.touches[0];
					offset.x = touch.clientX - win.offsetLeft;
					offset.y = touch.clientY - win.offsetTop;
					win.style.zIndex = Number(new Date().getTime() / 1000).toFixed(0);
				});
				
				document.addEventListener('touchmove', (e) => {
					if (!isDragging) return;
					const touch = e.touches[0];
					win.style.left = (touch.clientX - offset.x) + 'px';
					win.style.top = (touch.clientY - offset.y) + 'px';
				});
				
				document.addEventListener('touchend', () => isDragging = false);
			});

			// Real-time Clock
			setInterval(() => {
				const now = new Date();
				document.getElementById('clock').innerText = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
			}, 1000);

			// Photo Slideshow with Film Effect
			const canvas = document.getElementById('filmCanvas');
			const ctx = canvas.getContext('2d');
			const photos = [
				'/my-portfolio/photo/mm1.jpg',
				'/my-portfolio/photo/mm2.jpg',
				'/my-portfolio/photo/mm3.jpg',
				'/my-portfolio/photo/mm4.jpg',
				'/my-portfolio/photo/mm5.jpg'
			];
			let currentIndex = 0;
			let images = [];

			// Preload images
			photos.forEach((src, i) => {
				const img = new Image();
				img.src = src;
				images[i] = img;
			});

			function applyFilmEffect() {
				const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
				const data = imageData.data;

				// Add grain and flicker
				const flicker = 1 + (Math.random() * 0.08 - 0.04);
				
				for (let i = 0; i < data.length; i += 4) {
					const noise = Math.random() * 16 - 8;
					data[i] = Math.min(255, Math.max(0, data[i] * flicker + noise));
					data[i + 1] = Math.min(255, Math.max(0, data[i + 1] * flicker + noise));
					data[i + 2] = Math.min(255, Math.max(0, data[i + 2] * flicker + noise));
				}

				ctx.putImageData(imageData, 0, 0);
			}

			function drawPhoto() {
				if (images[currentIndex].complete) {
					const img = images[currentIndex];
					const scale = Math.min(canvas.width / img.width, canvas.height / img.height);
					const x = (canvas.width - img.width * scale) / 2;
					const y = (canvas.height - img.height * scale) / 2;
					
					ctx.fillStyle = 'black';
					ctx.fillRect(0, 0, canvas.width, canvas.height);
					ctx.drawImage(img, x, y, img.width * scale, img.height * scale);
					applyFilmEffect();
				}
			}

			function nextPhoto() {
				currentIndex = (currentIndex + 1) % photos.length;
				drawPhoto();
			}

			// Animation loop for film effect
			setInterval(drawPhoto, 50);
			// Change photo every 3 seconds
			setInterval(nextPhoto, 1500);

			// Auto-open photo window after 2 seconds
			setTimeout(() => {
				const photoWin = document.getElementById('win-photo');
				photoWin.style.left = '100px';
				photoWin.style.top = '80px';
				openWindow('win-photo');
				drawPhoto();
			}, 2000);

			// Auto-open resume window after 2.5 seconds (only on desktop)
			setTimeout(() => {
				if (window.innerWidth > 1024) {
					const resumeWin = document.getElementById('win-resume');
					resumeWin.style.left = '650px';
					resumeWin.style.top = '80px';
					openWindow('win-resume');
				}
			}, 2500);
		</script>

