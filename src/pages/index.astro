				font-family: 'Prompt', system-ui, sans-serif !important;
				overflow: hidden;
				cursor: url('https://win95.ajf.me/cursors/arrow.cur'), auto;
				font-size: 15px;
				line-height: 1.6;
			}

			/* --- Desktop Layout --- */
