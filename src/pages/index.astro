				height: calc(100vh - 35px);
				padding: 15px;
				display: grid;
				grid-template-columns: repeat(auto-fill, 80px);
				grid-template-rows: repeat(auto-fill, 100px);
				grid-auto-flow: column;
				gap: var(--icon-spacing);
			}

			/* --- Shortcut Icons --- */
